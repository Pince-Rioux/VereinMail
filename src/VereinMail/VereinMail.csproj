<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>VereinMail</PackageId>
    <Title>VereinMail</Title>
    <Version>1.0.1-dev</Version>
    <Authors>Yves Rioux (Pince-Rioux)</Authors>
    <Description>Plain-text email transport for .NET 8 and later, with SMTP, development .eml files, and a log-only fallback.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>email;smtp;mail</PackageTags>
    <PackageProjectUrl>https://github.com/Pince-Rioux/VereinMail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pince-Rioux/VereinMail.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires STARTTLS by default. Insecure SMTP settings now require explicit opt-in. FileEmailSender takes IHostEnvironment instead of IWebHostEnvironment. See the packaged README for migration details.</PackageReleaseNotes>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>

</Project>